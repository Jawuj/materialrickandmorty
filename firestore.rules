rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validSettings(settings) {
      return settings is map
        && settings.keys().hasAll(['darkTheme', 'language', 'hideEmail'])
        && settings.keys().hasOnly(['darkTheme', 'language', 'hideEmail'])
        && settings.darkTheme is bool
        && settings.language is string
        && settings.language.size() > 0
        && settings.language.size() <= 32
        && settings.hideEmail is bool;
    }

    function validProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'uid', 'name', 'email', 'photoUrl', 'favorites',
          'favoriteEpisodes', 'episodesWatched', 'settings'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'photoUrl', 'favorites',
          'favoriteEpisodes', 'episodesWatched', 'settings'
        ])
        && data.uid is string
        && data.uid == userId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.email is string
        && data.email.size() <= 254
        && data.photoUrl is string
        && data.photoUrl.size() <= 2048
        && data.favorites is list
        && data.favorites.size() <= 1000
        && data.favoriteEpisodes is list
        && data.favoriteEpisodes.size() <= 1000
        && data.episodesWatched is list
        && data.episodesWatched.size() <= 1000
        && validSettings(data.settings);
    }

    // This profile includes email and private settings, so only its owner may access it.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && validProfile(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
